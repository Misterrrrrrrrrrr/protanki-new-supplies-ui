{
  "manifest_version": 3,
  "name": "ProTanki New Supplies UI & Box Textures",
  "version": "1.0",
  "description": "Newer Supplies UI and Box Textures for ProTanki. Cosmetic only, no gameplay changes.",
  "content_scripts": [
    {
      "matches": [
        "https://play-protanki.com/*"
      ],
      "js": [
        "inject.js",
        "net.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://play-protanki.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "hud.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "sounds/*.mp3",
        "fx/*.png",
        "boxes/*"
      ],
      "matches": [
        "https://play-protanki.com/*"
      ]
    }
  ]
}